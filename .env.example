# Copy to .env and fill the key locally. Never commit .env.
ZEST_MODEL_PROVIDER=deepseek
ZEST_MODEL_NAME=deepseek-v4-flash
ZEST_MODEL_BASE_URL=https://api.deepseek.com
ZEST_MODEL_API_KEY=
ZEST_MODEL_TIMEOUT=60

# QA source budget in characters (not model tokens), default 128000; range 1-1000000.
ZEST_QA_CONTEXT_CHARS=128000

# Optional one-call diagnostics. Configuration alone never enables trace upload.
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=zest-structured-diagnostics
